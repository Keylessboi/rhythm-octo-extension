index 36038f15..506af92c 100644
--- a/app/src/main/java/chromahub/rhythm/app/features/streaming/presentation/viewmodel/StreamingMusicViewModel.kt
+++ b/app/src/main/java/chromahub/rhythm/app/features/streaming/presentation/viewmodel/StreamingMusicViewModel.kt
@@ -1670,6 +1670,19 @@ class StreamingMusicViewModel(application: Application) : AndroidViewModel(appli
         }
     }
 
+    /** Fork (Octo): "Start radio from this song": the song, then songs like it (Octo mixes owned and previewed ones). */
+    fun startRadio(songId: String) {
+        viewModelScope.launch {
+            val seed = knownSong(songId) ?: try { repository.getSongById(songId) as? StreamingSong } catch (e: Exception) { null }
+            val related = try { repository.getRelatedTracks(songId, 60) } catch (e: Exception) { emptyList() }
+            if (seed == null || related.isEmpty()) {
+                showToast("No radio for this song")
+                return@launch
+            }
+            playQueue(chromahub.rhythm.app.features.octo.RadioQueue.build(seed, related, { it.id }), 0)
+        }
+    }
+
     private fun knownSong(songId: String): StreamingSong? =
         _allSongs.value.firstOrNull { it.id == songId }
             ?: _likedSongs.value.firstOrNull { it.id == songId }
