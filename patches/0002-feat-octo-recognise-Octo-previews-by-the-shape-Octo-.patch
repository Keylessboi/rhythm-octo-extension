+++ b/app/src/test/java/chromahub/rhythm/app/features/streaming/data/provider/SubsonicIsExternalTest.kt
@@ -84,6 +84,16 @@ class SubsonicIsExternalTest {
         assertFalse(songsById().getValue("plain").isExternal)
     }
 
+    @Test
+    fun anOctoPreviewThatClaimsToBeOwnedIsStillSeenAsExternal() {
+        assertTrue(songsById().getValue("octo").isExternal)
+    }
+
+    @Test
+    fun aRealLibrarySongWithTheSameTagsIsNot() {
+        assertFalse(songsById().getValue("real").isExternal)
+    }
+
     @Test
     fun aFlagOfTheWrongTypeIsIgnored() {
         assertFalse(songsById().getValue("weird").isExternal)
@@ -94,7 +104,11 @@ class SubsonicIsExternalTest {
             {"id":"preview","title":"P","artist":"A","album":"B","duration":100,"isExternal":true},
             {"id":"owned","title":"O","artist":"A","album":"B","duration":100,"isExternal":false},
             {"id":"plain","title":"N","artist":"A","album":"B","duration":100},
-            {"id":"weird","title":"W","artist":"A","album":"B","duration":100,"isExternal":"yes"}
+            {"id":"weird","title":"W","artist":"A","album":"B","duration":100,"isExternal":"yes"},
+            {"id":"octo","title":"Bobby","artist":"Phoebe Bridgers","album":"Lost Weekend","duration":100,"isExternal":false,
+             "suffix":"m4a","bitRate":128,"samplingRate":44100,"path":"Phoebe Bridgers/Lost Weekend/Bobby.m4a"},
+            {"id":"real","title":"Bobby","artist":"Phoebe Bridgers","album":"Lost Weekend","duration":100,"isExternal":false,
+             "suffix":"m4a","bitRate":128,"samplingRate":44100,"path":"Phoebe Bridgers/Lost Weekend/03 - Bobby.m4a"}
         """.trimIndent()
     }
 
